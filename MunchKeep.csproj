<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <RootNamespace>MunchKeep</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- The game csproj lives at the repo root, so keep the test project out of its globs. -->
  <ItemGroup>
    <Compile Remove="MunchKeep.Tests/**" />
    <Content Remove="MunchKeep.Tests/**" />
    <None Remove="MunchKeep.Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.3.9" />
  </ItemGroup>
  <!--
    Assets, data definitions and fonts are loaded at runtime (Texture2D.FromStream +
    JSON manifests) rather than through the MGCB content pipeline, so re-skinning or
    rebalancing the game is a pure file swap with no content rebuild.
  -->
  <ItemGroup>
    <Content Include="Content\Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Content\Data\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Content\Fonts\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
